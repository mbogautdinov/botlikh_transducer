ThirdObl [>:>] [<pl.obl>:ду] [>:>] [<gen>:] ClGenAgr
ThirdObl [>:>] [<m.obl>:щу] [>:>] LocAll
ThirdObl [>:>] [<pl.obl>:ду] [>:>] LocAll
ThirdObl [>:>] [<nm.obl>:лълъи] [>:>] LocAll

LEXICON ThirdStem

гьиб<PRON><dem>:гьи  # он, она, оно, они

LEXICON ThirdObl

гьиб<PRON><dem>:ин  # он, она, оно, они

LEXICON ClThird

<m>:в[m]
<f>:й[nm]
<n>:б[nm]
<inan.pl>:б[nm]
<an.pl>:вол[pl]

PATTERN Demonstrative

DemStem [>:>] ClDem
DemStem [>:>] [<m.obl>:щу] [>:>] CaseCard
DemStem [>:>] [<pl.obl>:лу] [>:>] CaseCard
DemStem [>:>] [<nm.obl>:лълъи] [>:>] CaseCard[erg]
DemStem [>:>] [<nm.obl>:лълъи] [>:>] [<dat>:й]
DemStem [>:>] [<nm.obl>:лълъи] [>:>] [<dat>:]
DemStem [>:>] [<nm.obl>:] [>:>] [<gen>:лъилъи]
DemStem [>:>] [<nm.obl>:лълъи] [>:>] [<gen>:лъи]
DemStem [>:>] [<m.obl>:щу] [>:>] [<gen>:] ClGenAgr
DemStem [>:>] [<pl.obl>:лу] [>:>] [<gen>:] ClGenAgr
DemStem [>:>] [<m.obl>:щу] [>:>] LocAll
DemStem [>:>] [<pl.obl>:лу] [>:>] LocAll
DemStem [>:>] [<nm.obl>:лълъи] [>:>] LocAll
DemStem[simple] [>:>] [<in.lat>:лъа]

LEXICON DemStem

гьаб<PRON><dem>:гьа[simple]  # этот (близко к говорящему)
гьуб<PRON><dem>:гьу[simple]  # этот (близко к слушающему)
гоб<PRON><dem>:го[simple]    # тот (далеко от обоих)
габ<PRON><dem>:га[simple]    # тот (недалеко и сбоку от говорящего)
доб<PRON><dem>:до[simple]    # он, она, оно; тот
гьацеб<PRON><dem>:гьаце      # этот
гьуцеб<PRON><dem>:гьуце      # этот
гоцеб<PRON><dem>:гоце        # тот

LEXICON ClDem

<m>:в[m]
<f>:й[nm]
<n>:б[nm]
<inan.pl>:б[nm]
<an.pl>:л[pl]

LEXICON ClGenAgr

<m>:в
<f>:й
<an.pl>:л

PATTERN Qualitative

QualStem [>:>] ClDem

