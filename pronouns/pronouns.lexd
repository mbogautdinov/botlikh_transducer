ThirdObl [>:>] [<nm.obl>:лълъи] [>:>] [<dat>:]
ThirdObl [>:>] [<nm.obl>:] [>:>] [<gen>:лъилъи]
ThirdObl [>:>] [<nm.obl>:лълъи] [>:>] [<gen>:лъи]
